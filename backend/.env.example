# LiveKit Cloud project credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match agent/.env; use a unique name for each developer's local worker.
LIVEKIT_AGENT_NAME=mimir-tutor

# MyScript Cloud handwriting recognition (https://cloud.myscript.com)
MYSCRIPT_APPLICATION_KEY=
MYSCRIPT_HMAC_KEY=
MYSCRIPT_LOCALE=en_US
MYSCRIPT_ENABLED=true
MYSCRIPT_SCALE_X=0.264583
MYSCRIPT_SCALE_Y=0.264583

# OpenRouter Physics word-problem visualization
OPENROUTER_API_KEY=
OPENROUTER_VISUALIZATION_MODEL=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_VISUALIZATION_ENABLED=true

# Comma-separated frontend origins (set for a separate local preview).
CORS_ORIGINS=http://localhost:3000
