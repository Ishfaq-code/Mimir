# LiveKit Cloud project credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI API key with Realtime API access
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_REALTIME_MODEL=gpt-realtime
# TUTOR_VOICE=marin
# TUTOR_TTS_MODEL=gpt-4o-mini-tts

# Separate visual math checker (one bounded request per student turn)
# TUTOR_REASONING_MODEL=gpt-5.4-mini
# TUTOR_REASONING_EFFORT=low
