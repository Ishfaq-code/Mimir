# LiveKit Cloud project credentials (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match backend/.env; use a unique name for each developer's local worker.
LIVEKIT_AGENT_NAME=mimir-tutor

# One native Gemini session handles voice, canvas vision, and tutoring.
TUTOR_PROVIDER=gemini
# Server-side; never put this in NEXT_PUBLIC_* variables.
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Puck

# Optional legacy provider: TUTOR_PROVIDER=openai requires the key below.
# Gemini tutoring does not use the OpenAI planner or text-to-speech service.
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# TUTOR_VOICE=marin
# TUTOR_TTS_MODEL=gpt-4o-mini-tts

# Legacy OpenAI planner only; Gemini uses the local math checker directly.
# TUTOR_REASONING_MODEL=gpt-5.4-mini
# TUTOR_REASONING_EFFORT=low
